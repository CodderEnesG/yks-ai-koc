# Edge Function secret'ları, yalnız yerel `supabase functions serve --env-file supabase/functions/.env` için.
# .env olarak kopyala; .env commit edilmez. Uzak projede `supabase secrets set` ile tanımlı.
# SUPABASE_URL, SUPABASE_ANON_KEY ve SUPABASE_SERVICE_ROLE_KEY'i Supabase kendisi verir.

# toc-extract, classify, chat (Claude Haiku 5.5)
ANTHROPIC_API_KEY=

# youtube-import (YouTube Data API v3; yalnız API anahtarı, OAuth yok)
YOUTUBE_API_KEY=
