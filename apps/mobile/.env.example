# Uygulamaya gömülen Supabase ayarları (gizli değil; veriyi RLS korur). .env olarak kopyala.
# Yerel: supabase status -o env (API_URL, PUBLISHABLE_KEY). Uzak: Dashboard → Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Veli onay sayfasının adresi (apps/web). Yerel: http://localhost:3000
EXPO_PUBLIC_WEB_URL=
