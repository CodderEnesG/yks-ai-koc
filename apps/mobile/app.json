{
  "expo": {
    "name": "YKS Koç",
    "slug": "yks-koc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ykskoc",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "dev.placeholder.ykskoc"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.placeholder.ykskoc"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Kitabının barkodunu okutmak için kamerayı kullanıyoruz. Görüntü kaydedilmez.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#171717"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "İçindekiler sayfasının fotoğrafını seçmek için galerine erişiyoruz. Fotoğraf okunduktan sonra silinir.",
          "cameraPermission": "İçindekiler sayfasının fotoğrafını çekmek için kamerayı kullanıyoruz. Fotoğraf okunduktan sonra silinir.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
