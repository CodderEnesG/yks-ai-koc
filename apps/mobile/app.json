{
  "expo": {
    "name": "lamba",
    "slug": "yks-koc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ykskoc",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "dev.placeholder.ykskoc"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1C1330",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.placeholder.ykskoc"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1C1330",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Kitabının barkodunu okutmak için kamerayı kullanıyoruz. Görüntü kaydedilmez.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF9F43"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "İçindekiler sayfasının fotoğrafını seçmek için galerine erişiyoruz. Fotoğraf okunduktan sonra silinir.",
          "cameraPermission": "İçindekiler sayfasının fotoğrafını çekmek için kamerayı kullanıyoruz. Fotoğraf okunduktan sonra silinir.",
          "microphonePermission": false
        }
      ],
      "expo-localization",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/source-sans-3/400Regular/SourceSans3_400Regular.ttf",
            "./node_modules/@expo-google-fonts/source-sans-3/600SemiBold/SourceSans3_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/source-sans-3/700Bold/SourceSans3_700Bold.ttf",
            "./node_modules/@expo-google-fonts/bricolage-grotesque/700Bold/BricolageGrotesque_700Bold.ttf",
            "./node_modules/@expo-google-fonts/bricolage-grotesque/800ExtraBold/BricolageGrotesque_800ExtraBold.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
