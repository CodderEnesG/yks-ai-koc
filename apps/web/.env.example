# Veli onay ve rapor sayfalarının Supabase ayarları (gizli değil; veriyi RLS ve fonksiyonlar korur).
# .env.local olarak kopyala. Yerel: supabase status -o env (API_URL, PUBLISHABLE_KEY).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Tanıtım sitesi (T40). Alan adı seçilince (karar 8): paylaşım kartı, sitemap ve veliye paylaşılan link.
NEXT_PUBLIC_SITE_URL=
# Bekleme listesi formu yalnız aydınlatma metni onaylanınca (T07) açılır: 1
NEXT_PUBLIC_WAITLIST_OPEN=
# Destek sayfası ve alt bilgideki iletişim adresi (ör. info@<alan adı>)
NEXT_PUBLIC_CONTACT_EMAIL=
# Arama motoruna açık mı (yalnız üretim, yayın kapıları açılınca): 1. Boşken noindex. Yerel ve önizlemede gerekmez.
SITE_INDEXABLE=
