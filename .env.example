# Yerel geliştirme ayarları. Bu dosyayı .env olarak kopyala ve doldur; .env commit edilmez.

# T05 içindekiler okuma testi (tools/toc-eval). Yalnız MEB OGM görüntüleri gönderilir.
ANTHROPIC_API_KEY=

# Supabase (Frankfurt, eu-central-1). Dashboard → Project Settings → API / General.
# URL ve publishable anahtar uygulamaya gömülür, gizli değildir; veriyi RLS korur.
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Gizli olanlar (secret anahtar, veritabanı şifresi) buraya ve sohbete yazılmaz:
# DB şifresi `supabase link` sorunca girilir; secret anahtar Edge Function secret'ı olarak verilir.
