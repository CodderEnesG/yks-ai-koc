# Yerel geliştirme ayarları. Bu dosyayı .env olarak kopyala ve doldur; .env commit edilmez.

# T05 içindekiler okuma testi (tools/toc-eval). Yalnız MEB OGM görüntüleri gönderilir.
ANTHROPIC_API_KEY=

# Gemini, Vertex AI üzerinden makinedeki gcloud kimlik bilgisiyle çağrılır
# (`gcloud auth application-default login`); API anahtarı gerekmez.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash-lite
